[Unit]
Description=Chiron Rising LLM diplomacy bridge (HTTP front end for synapd)
Documentation=https://github.com/velle999/Chiron-Rising
# synapd.socket activates synapd on demand, so this deliberately does NOT
# Requires= synapd.service -- see synapd-bridge.service for why pulling the
# daemon up as a dependency resurrects the model after game mode stops it.
After=network.target

[Service]
Type=exec
ExecStart=%h/chiron-smacx/bridge/chiron-bridge.py --host 127.0.0.1 --port 11436
Restart=on-failure
RestartSec=2

# To run the Claude backend under this unit, override all three of these
# (systemctl --user edit chiron-bridge). A comment may not share a line with a
# directive here -- a trailing # is read as part of the value, not as a comment.
#
#   [Service]
#   ExecStart=
#   ExecStart=%h/chiron-smacx/bridge/chiron-bridge.py --host 127.0.0.1 --port 11436 --backend claude,synapd
#   EnvironmentFile=%h/.config/chiron/anthropic.env
#   RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
#
# The env file holds ANTHROPIC_API_KEY=... and should be chmod 600; the unit
# reads it as the user, so it never needs to be world-readable. AF_INET6 is
# added because the list below omits it, and an IPv6-first resolver would
# otherwise fail to reach api.anthropic.com in a way that looks like a hang.

# Loopback only, and it just moves bytes between a TCP socket and a unix socket.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=default.target
